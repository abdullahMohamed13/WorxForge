# Leave empty locally to use Vite's API and SignalR proxies.
# Set to a public API URL for a deployment with a separate API origin.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://localhost:7235

# Guest mode is the default; no login account or Google client ID is required.
# TODO: Login is skipped pending adding an SMTP account and completing account flows.
# Optional only when GuestAccess:Enabled=false is explicitly configured on the API:
VITE_GOOGLE_CLIENT_ID=
